# .env.example
# Supabase Credentials
# Get these from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_public_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"  # KEEP SECRET - Never expose to client

# Application Settings
NODE_ENV=development
PORT=3000

# Cloudflare R2 Storage (For Customer App voice notes & problem photos)
# Found in Cloudflare Dashboard > R2 > Manage R2 API Tokens
CLOUDFLARE_R2_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
CLOUDFLARE_R2_BUCKET_NAME="gnapika-storage"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxxxxx.r2.dev" # Optional public bucket domain

# Expo / EAS (In customer-app/.env)
# EXPO_TOKEN="your_expo_token"